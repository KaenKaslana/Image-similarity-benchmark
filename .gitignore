# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/
.venv/
venv/

# API tokens (Sketchfab / Tripo / Meshy) - never commit
.env

# Downloaded 3D models (Sketchfab cache)
models/*
!models/.gitkeep

# Benchmark outputs (keep the folder, ignore run directories)
outputs/run_*/

# Editors / OS
.vscode/*
!.vscode/settings.json
.idea/
Thumbs.db
.DS_Store

# Sample / user images (regenerate with: python scripts/make_sample_data.py)
data/reference/*
data/candidate/*
!data/reference/.gitkeep
!data/candidate/.gitkeep

# Blender MCP smoke-test screenshot (scripts/blender_mcp_smoke.py)
outputs/mcp_smoke.png

# Agent benchmark runs (python -m src.agentbench)
workspaces/*/runs/
