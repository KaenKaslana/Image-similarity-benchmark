{
  "name": "mug-builtin",
  "description": "Agent models a mug with this project's own tools (Python + trimesh, benchmark renderer); no Blender needed.",

  "runtime": {
    "type": "builtin",
    "tools": ["list_files", "read_file", "write_file", "read_image", "run_python", "render_views"]
  },

  "llm": {
    "api_format": "anthropic",
    "base_url": "${ANTHROPIC_BASE_URL:-https://api.anthropic.com}",
    "api_key": "${ANTHROPIC_API_KEY}",
    "model": "claude-opus-5",
    "max_tokens": 32000,
    "thinking": {"type": "adaptive", "display": "summarized"}
  },

  "workspace": {
    "root": "../../workspaces/example",
    "output_dir": "runs"
  },

  "limits": {
    "max_turns": 30,
    "timeout_seconds": 1800
  },

  "evaluation": {
    "feedback_rounds": 1
  },

  "tasks": [
    {
      "id": "mug",
      "prompt": "做一个马克杯的三维模型：圆柱形杯身，杯口敞开、杯壁有一定厚度，平底，侧面有一个 C 形把手。形状和比例以参考图片为准。",
      "reference_images": ["refs/mug/front.png", "refs/mug/side.png", "refs/mug/top.png", "refs/mug/iso.png"],
      "reference_model": "answers/mug.glb"
    }
  ]
}
